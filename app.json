{
  "expo": {
    "name": "NxMirror",
    "slug": "nxmirror",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nxmirror",
    "backgroundColor": "#0B0E14",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crossberry.nxmirror"
    },
    "android": {
      "package": "com.crossberry.nxmirror",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0E14"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0E14"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow NxMirror to access your Face ID for secure sign-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NxMirror to access your photos so you can pick a profile avatar and upload images to your cloud.",
          "cameraPermission": "Allow NxMirror to use the camera to capture images for upload."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "nxmirror": {
        "defaultApiBaseUrl": "https://nxmirror.netlify.app"
      }
    }
  }
}
